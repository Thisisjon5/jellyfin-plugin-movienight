<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.MovieNight</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.6" >
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.6">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase 1 spike test HLS asset, embedded directly into the DLL rather than shipped as loose
      files alongside it: on the target NAS, files extracted from the plugin zip appeared in
      directory listings but genuinely could not be opened (File.Exists returned false, matching
      an ENOENT from a separate host-side read) - a filesystem quirk with this specific
      environment's zip extraction, not our code. Embedding sidesteps it entirely.
    -->
    <None Remove="Resources\Hls\*" />
    <EmbeddedResource Include="Resources\Hls\master.m3u8">
      <LogicalName>Jellyfin.Plugin.MovieNight.Hls.master.m3u8</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Hls\segment_000.ts">
      <LogicalName>Jellyfin.Plugin.MovieNight.Hls.segment_000.ts</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Hls\segment_001.ts">
      <LogicalName>Jellyfin.Plugin.MovieNight.Hls.segment_001.ts</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Hls\segment_002.ts">
      <LogicalName>Jellyfin.Plugin.MovieNight.Hls.segment_002.ts</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Hls\segment_003.ts">
      <LogicalName>Jellyfin.Plugin.MovieNight.Hls.segment_003.ts</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
